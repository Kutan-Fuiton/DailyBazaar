APP_NAME=Vaniq
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ── Database (Supabase PostgreSQL / MySQL) ──
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_MAIN_DB=vaniq_main

# ── Redis (Free Cloud Tier: Upstash / Redis Cloud, or Local) ──
# For Local: redis://127.0.0.1:6379/0
# For Upstash (Free Tier): rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379
# For Redis Cloud (Free Tier): redis://default:[PASSWORD]@[ENDPOINT].redislabs.com:PORT
REDIS_URL=redis://127.0.0.1:6379/0


# ── JWT Authentication ──
SECRET_KEY=change_to_a_secure_random_64_character_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

# ── Frontend CORS ──
FRONTEND_URL=http://localhost:5174

# ── OCR & Vision Processing ──
HF_TOKEN=
LLAMA_API_KEY=
OCR_ITEMS_JSON=app/ocr/items.json
