# ==============================================================================
# DailyBazaar (Vaniq) — Example Environment Configuration
# Copy this file to .env in the project root and fill in your credentials.
# ==============================================================================

APP_NAME=Vaniq
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ── Primary Database: Supabase PostgreSQL (Cloud) ──
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# ── Secondary Database: Local MySQL (Development Fallback) ──
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_MAIN_DB=vaniq_main

# ── Distributed Cache: Upstash Redis (TLS) ──
REDIS_URL=rediss://default:[TOKEN]@[HOST].upstash.io:6379

# ── JWT Authentication ──
SECRET_KEY=generate_a_secure_random_64_char_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Frontend & APIs ──
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000

# ── AI Vision & OCR Extraction ──
HF_TOKEN=
LLAMA_API_KEY=
OCR_ITEMS_JSON=app/ocr/items.json
